# Copy to .env for local runs outside docker compose.
# Inside compose these are supplied by compose.yaml; .env is NOT baked into the image.

ENV=local
DATABASE_URL=postgresql+asyncpg://abacus:abacus@localhost:5432/abacus
BROKER_URL=amqp://abacus:abacus@localhost:5672/

# WebSocket transport (docs/websocket.md). All have defaults; these are the ones
# you are most likely to need to set.
#
# Browser origins allowed to open a chat socket, as a JSON list. Empty is
# permissive ONLY when ENV=local — anywhere else an empty list denies every
# browser origin, so forgetting this fails closed rather than open.
# WS_ALLOWED_ORIGINS=["https://app.example.com"]
# WS_MAX_CONNECTIONS_PER_SESSION=8

# Object storage (docs/worker.md). The defaults point at compose's `minio`
# hostname, which only resolves inside the compose network — running the tests
# or a worker from the host needs the endpoint below.
S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=abacus-artifacts
# S3_ACCESS_KEY=abacus
# S3_SECRET_KEY=abacus-local-secret

# Phase 4. Held only by the gateway service — never by a worker container.
# ANTHROPIC_API_KEY=
